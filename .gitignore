# NexusOps .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual Environments
venv/
.venv/
env/
ENV/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# OS Files
.DS_Store
Thumbs.db
Desktop.ini

# Environment & Secrets
.env
.env.local
.env.*.local
!.env.example

# Database (dev)
db.sqlite3
db.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# Django
staticfiles/
media/
*.log
logs/
maintenance.flag

# Docker
docker-compose.override.yml

# AI Models (large binary files - use Git LFS or separate storage)
# ai_models/*.joblib

# Temp & Uploads
products/temp/
product_images/ocr_uploads/
product_images/user_backups/

# Coverage & Testing
.coverage
htmlcov/
.pytest_cache/
.tox/
nosetests.xml
coverage.xml

# Node (if frontend tooling is added later)
node_modules/
package-lock.json
yarn.lock