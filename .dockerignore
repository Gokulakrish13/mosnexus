.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment files (secrets)
.env
.env.local
.env.*.local

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# Documentation
*.md
docs/
LICENSE

# Tests
tests/
.pytest_cache/
.coverage
htmlcov/

